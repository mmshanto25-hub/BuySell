# ==========================================
# ENTERPRISE MULTI-VENDOR MARKETPLACE ENV
# ==========================================

# Node Environment
NODE_ENV=development
PORT=5000

# Base URLs
API_BASE_URL=http://localhost:5000/api/v1
STOREFRONT_URL=http://localhost:3000
SELLER_DASHBOARD_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002

# MongoDB Connection
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/marketplace?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/marketplace

# Redis Connection (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Security
# Generate using: openssl rand -base64 64
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Session Cookie Secret
COOKIE_SECRET=your-secure-cookie-signing-secret

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payment Gateways (Sandbox / Live)
# bKash Tokenized Checkout
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_SANDBOX=true

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Courier APIs (Logistics)
# Pathao Courier
PATHAO_CLIENT_ID=your-pathao-client-id
PATHAO_CLIENT_SECRET=your-pathao-client-secret
PATHAO_USERNAME=your-pathao-username
PATHAO_PASSWORD=your-pathao-password
PATHAO_SANDBOX=true

# Steadfast Courier
STEADFAST_API_KEY=your-steadfast-api-key
STEADFAST_SECRET_KEY=your-steadfast-secret-key

# Transactional Communication
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Marketplace <no-reply@marketplace.com>

# AI & LLM Providers
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
